NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/placementhub
# Set a randomly generated secret of at least 32 characters; never commit it.
JWT_SECRET=

# Comma-separated exact frontend origins; no wildcards or trailing slashes.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Cross-site HTTPS deployments need none; same-site deployments can use strict.
REFRESH_COOKIE_SAME_SITE=strict
# Set only to the exact number of trusted reverse-proxy hops.
TRUST_PROXY_HOPS=0
